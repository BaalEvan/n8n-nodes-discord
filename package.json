{
  "name": "@baalevan/n8n-nodes-discord",
  "version": "0.5.0",
  "description": "n8n node for Discord API integration. Supports Discord REST operations, webhooks, interactions, and Gateway triggers.",
  "license": "MIT",
  "homepage": "https://github.com/BaalEvan/n8n-nodes-discord",
  "bugs": {
    "url": "https://github.com/BaalEvan/n8n-nodes-discord/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "discord",
    "gateway",
    "webhook",
    "interactions",
    "bot"
  ],
  "author": {
    "name": "yuniruyuni",
    "email": "yuniruyuni@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuniruyuni/n8n-nodes-discord.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DiscordBotApi.credentials.js",
      "dist/credentials/DiscordOAuth2Api.credentials.js",
      "dist/credentials/DiscordWebhookApi.credentials.js",
      "dist/credentials/DiscordInteractionApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Discord/Discord.node.js",
      "dist/nodes/DiscordTrigger/DiscordTrigger.node.js",
      "dist/nodes/DiscordWebhookEventTrigger/DiscordWebhookEventTrigger.node.js",
      "dist/nodes/DiscordGatewayCommand/DiscordGatewayCommand.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.2",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "release-it": "^21.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
