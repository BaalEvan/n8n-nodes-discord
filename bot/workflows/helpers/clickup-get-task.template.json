{
	"name": "Discord Helper: ClickUp Get Task",
	"nodes": [
		{
			"id": "c1d2e3f4-1a2b-4c3d-8e4f-5a6b7c8d9e01",
			"name": "When called by another workflow",
			"type": "n8n-nodes-base.executeWorkflowTrigger",
			"typeVersion": 1.3,
			"position": [
				0,
				300
			],
			"parameters": {
				"inputSource": "workflowInputs",
				"workflowInputs": {
					"values": [
						{
							"name": "taskId",
							"type": "string"
						}
					]
				}
			}
		},
		{
			"id": "c1d2e3f4-1a2b-4c3d-8e4f-5a6b7c8d9e02",
			"name": "Try ClickUp",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				260,
				300
			],
			"notes": "Prototype. npm run build:bot expands this node into one \"Try <credential name>\" node per entry of the CLICKUP_CREDENTIALS environment variable (names separated by ;, default \"ClickUp (Client)\"). Each Try node uses the clickUpApi credential of that name; its error output goes to the next Try node, the last one to Not Found. To add a workspace: create the credential in n8n, add its name to CLICKUP_CREDENTIALS, rebuild and re-import.",
			"parameters": {
				"method": "GET",
				"url": "=https://api.clickup.com/api/v2/task/{{ encodeURIComponent($json.taskId) }}",
				"authentication": "predefinedCredentialType",
				"nodeCredentialType": "clickUpApi",
				"sendHeaders": true,
				"headerParameters": {
					"parameters": [
						{
							"name": "accept",
							"value": "application/json"
						}
					]
				},
				"options": {}
			},
			"onError": "continueErrorOutput"
		},
		{
			"id": "c1d2e3f4-1a2b-4c3d-8e4f-5a6b7c8d9e03",
			"name": "Build Embed",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				560,
				200
			],
			"parameters": {
				"mode": "runOnceForEachItem",
				"language": "javaScript",
				"jsCode": "//@inline lib/clickup.js\nreturn { json: { found: true, embed: buildTaskEmbed($json) } };"
			}
		},
		{
			"id": "c1d2e3f4-1a2b-4c3d-8e4f-5a6b7c8d9e04",
			"name": "Not Found",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.5,
			"position": [
				560,
				400
			],
			"parameters": {
				"mode": "raw",
				"jsonOutput": "{\n  \"found\": false\n}",
				"options": {}
			}
		}
	],
	"connections": {
		"When called by another workflow": {
			"main": [
				[
					{
						"node": "Try ClickUp",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Try ClickUp": {
			"main": [
				[
					{
						"node": "Build Embed",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Not Found",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
