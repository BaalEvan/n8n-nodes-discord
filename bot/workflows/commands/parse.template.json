				"language": "javaScript",
				"jsCode": "//@inline lib/parseLog.js\nconst result = parseLog($json.log, $('Attachment').first().json);\nif (result.mode === 'file') {\n\tconst data = Buffer.from(result.file, 'utf8').toString('base64');\n\treturn [{ json: { mode: 'file', content: result.content }, binary: { file: { data: data, mimeType: 'text/plain', fileName: 'exceptions.log' } } }];\n}\nreturn [{ json: { mode: 'embeds', content: result.content, embeds: result.embeds } }];"
			}
