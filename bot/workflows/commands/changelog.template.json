			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/changelog.js\nconst o = $('When called by another workflow').first().json.interaction?.options ?? {};\nreturn [{ json: { url: buildChangelogUrl($input.first().json.value, o.buildid, o.skipai) } }];"
			}
		},
