				"jsonOutput": "{\n  \"name\": \"prompt\",\n  \"description\": \"Send a prompt to the AI\",\n  \"options\": [\n    {\n      \"type\": 3,\n      \"name\": \"prompt\",\n      \"description\": \"What to ask\",\n      \"required\": true\n    },\n    {\n      \"type\": 3,\n      \"name\": \"preset\",\n      \"description\": \"How to answer (leave empty for the default)\",\n      \"required\": false,\n      \"choices\": [\n        {\n          \"name\": \"Copy back (no AI)\",\n          \"value\": \"copy\"\n        },\n        {\n          \"name\": \"Final Fantasy XIV helper\",\n          \"value\": \"ffxiv\"\n        },\n        {\n          \"name\": \"Hotel Galactic assistant\",\n          \"value\": \"hg\"\n        },\n        {\n          \"name\": \"Smart (Gemini Pro)\",\n          \"value\": \"smart\"\n        },\n        {\n          \"name\": \"Steam discussions\",\n          \"value\": \"steam\"\n        },\n        {\n          \"name\": \"Bug report → JIRA ticket\",\n          \"value\": \"aom\"\n        },\n        {\n          \"name\": \"Board task summary\",\n          \"value\": \"tasks\"\n        },\n        {\n          \"name\": \"What game to play\",\n          \"value\": \"game\"\n        },\n        {\n          \"name\": \"Archi (creative writing, PL)\",\n          \"value\": \"archi\"\n        }\n      ]\n    }\n  ],\n  \"ephemeral\": false,\n  \"scope\": \"global\",\n  \"whitelist\": {\n    \"everyone\": true,\n    \"users\": [],\n    \"roles\": []\n  }\n}",
