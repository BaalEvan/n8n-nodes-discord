			"name": "Load Config",
			"type": "n8n-nodes-base.dataTable",
			"typeVersion": 1.1,
			"position": [660, 200],
			"parameters": {
				"resource": "row",
				"operation": "get",
				"dataTableId": {
					"__rl": true,
					"mode": "name",
					"value": "discord_config"
				},
				"filters": {
					"conditions": [
						{
							"keyName": "key",
							"condition": "eq",
							"keyValue": "webhookBase"
						}
					]
				},
				"limit": 1
			},
			"alwaysOutputData": true,
			"notes": "Base URL of the n8n instance that serves the gemini-hook webhook, from discord_config key webhookBase. Dev: https://black-n8n.potoroo-scylla.ts.net (import-dev adds it only when missing, and this hits the production hook). Production may use http://localhost:5678 if n8n listens there inside its container."
		},
		{
			"id": "f3a4b5c6-4d5e-4f60-9b72-7c8d9e0f1a11",
			"name": "Build URL",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [880, 200],
			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/prompt.js\nconst o = $('When called by another workflow').first().json.interaction?.options ?? {};\nreturn [{ json: { url: buildPromptUrl($input.first().json.value, o.prompt, o.preset) } }];"
			}
		},
		{
			"id": "f3a4b5c6-4d5e-4f60-9b72-7c8d9e0f1a12",
			"name": "Ask AI",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [1320, 200],
			"parameters": {
				"method": "GET",
				"url": "={{ $json.url }}",
				"options": {
					"response": {
						"response": {
							"responseFormat": "text",
							"outputPropertyName": "body"
						}
					},
					"timeout": 600000
				}
			},
			"onError": "continueErrorOutput",
			"notes": "The gemini-hook webhook needs no authentication and answers with plain text (or a JSON body with Text and Embeds). The interaction token lasts 15 minutes, so a longer wait cannot be answered anyway."
		},
		{
			"id": "f3a4b5c6-4d5e-4f60-9b72-7c8d9e0f1a13",
			"name": "Reply",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [1540, 100],
			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/prompt.js\nconst item = $input.first().json;\nreturn [{ json: buildResult(item.body ?? item.data) }];"
			}
		},
		{
			"id": "f3a4b5c6-4d5e-4f60-9b72-7c8d9e0f1a14",
			"name": "Reply Failed",
			"type": "n8n-nodes-base.code",
