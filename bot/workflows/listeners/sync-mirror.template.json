		{
			"id": "4aecf510-f153-4211-a4fb-173e58e78ae3",
			"name": "Gone?",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				1980,
				900
			],
			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/sync.js lib/syncMirror.js\nconst event = $('Filter').first().json.event;\nconst err = discordError($input.first());\nlet ctx;\nlet binary;\nif (event === 'create') {\n\tlet collected = null;\n\ttry {\n\t\tcollected = $('Collect Files').first();\n\t} catch (e) {\n\t\tcollected = null;\n\t}\n\tif (collected) {\n\t\tctx = collected.json;\n\t\tbinary = collected.binary;\n\t} else {\n\t\tctx = $('Prepare').first().json;\n\t}\n} else {\n\tctx = $('Mirror Target').first().json;\n}\nconst action = goneDecision(event, err);\nif (action === 'fail') {\n\tthrow new Error('Sync mirror ' + event + ' failed: ' + err.message + ' (Discord code ' + (err.code || 'none') + ', HTTP ' + (err.status || 'unknown') + ')');\n}\nconst item = { json: Object.assign({}, ctx, { event: event, action: action }) };\nif (binary) item.binary = binary;\nreturn [item];"
			}
		},
