				"language": "javaScript",
				"jsCode": "//@inline lib/syncApi.js\nconst built = $('Build').first().json;\nconst config = configValues($('Load Config').all());\nconst guildIds = parseGuildIds(config.guildIds);\nconst applicationId = String(($('Get Application').first().json || {}).id || '');\nif (!applicationId) throw new Error('Get Application returned no application id');\nreturn guildTargets(built, guildIds).map(function (target) {\n\treturn { json: { guildId: target.guildId, applicationId: applicationId, commands: target.commands } };\n});"
			}
