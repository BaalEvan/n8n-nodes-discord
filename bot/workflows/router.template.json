			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				1100,
				200
			],
			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/definition.js lib/whitelist.js lib/customId.js lib/route.js\nconst classified = $('Classify').first().json;\nconst lookup = $('Lookup Command').first().json || {};\nconst row =\n\tlookup.workflowId && lookup.name === classified.commandName\n\t\t? { workflowId: String(lookup.workflowId), definition: lookup.definition }\n\t\t: null;\nconst config = {};\nfor (const item of $input.all()) {\n\tif (item.json && item.json.key) config[item.json.key] = item.json.value;\n}\nconst decision = decideRoute(classified, row, String(config.ownerId || ''));\nreturn [\n\t{\n\t\tjson: Object.assign({}, decision, {\n\t\t\tclassified: classified,\n\t\t\tsyncWorkflowId: String(config.syncWorkflowId || ''),\n\t\t}),\n\t},\n];"
			}
		},
