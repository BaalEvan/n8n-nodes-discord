			"parameters": {
				"mode": "runOnceForAllItems",
				"language": "javaScript",
				"jsCode": "//@inline lib/result.js lib/format.js\nconst decision = $('Decide').first().json;\nconst item = $input.first();\nconst hasFile = Boolean(item.binary && item.binary.file);\nconst errorText = commandErrorText((decision.classified && decision.classified.commandName) || '');\nconst plan = formatResult(item.json, hasFile, decision);\nconst out = { json: Object.assign({ result: item.json, errorText: errorText }, plan) };\nif (hasFile) out.binary = { file: item.binary.file };\nreturn [out];"
			}
