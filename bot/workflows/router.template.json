				"autoCalculateIntents": false,
				"intents": [
					"GUILDS",
					"GUILD_MESSAGES",
					"MESSAGE_CONTENT"
				],
				"includeBotMessages": true,
				"emitRawPayload": false
			},
			"credentials": {
				"discordGatewayBotApi": {
					"name": "Discord Bot (live)"
				}
			},
			"notes": "Before publishing, replace __OWNER_ID__ in Alert User ID with the value of the discord_config row ownerId. Trigger parameters are read once at activation and cannot read Data Tables. Republish (deactivate, activate) after changing any trigger parameter."
